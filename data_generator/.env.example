# Copy this file to ".env" (same folder as main.py) and fill in your own values.
# .env itself is gitignored - never commit real credentials or API keys.

# --- SQL Server ---
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=EnterpriseProcurementSalesDb
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUSTED_CONNECTION=yes

# Only needed for SQL authentication (leave empty to use Windows authentication)
DB_USERNAME=
DB_PASSWORD=

# --- Optional: LLM-generated names/descriptions via Groq ---
# Leave GROQ_API_KEY empty (or set USE_LLM=false) to use Faker only.
USE_LLM=false
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
LLM_TEMPERATURE=0.4
LLM_MAX_RETRIES=2
