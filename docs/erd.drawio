        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    Branch {\n        int Id PK\n        string Name\n        string Location\n    }\n\n    Warehouse {\n        int Id PK\n        int BranchId FK\n        string Name\n        string Location\n    }\n\n    ApplicationUser {\n        string Id PK\n        string FullName\n        string Email\n        string Username\n        string Password\n        bool IsActive\n        int BranchId FK\n    }\n\n    Role {\n        string Id PK\n        string Name\n    }\n\n    UserRole {\n        int Id PK\n        string UserId FK\n        string RoleId FK\n    }\n\n    Category {\n        int Id PK\n        string Name\n    }\n\n    Product {\n        int Id PK\n        string Name\n        string SKU\n        decimal UnitPrice\n        int CategoryId FK\n    }\n\n    BranchInventory {\n        int Id PK\n        int WarehouseId FK\n        int ProductId FK\n        int StockQuantity\n    }\n\n    Vendor {\n        int Id PK\n        string Name\n        string ContactInfo\n    }\n\n    PurchaseOrder {\n        int Id PK\n        int VendorId FK\n        int BranchId FK\n        datetime OrderDate\n        string Status\n    }\n\n    PurchaseOrderItem {\n        int Id PK\n        int PurchaseOrderId FK\n        int ProductId FK\n        int Quantity\n        decimal UnitCost\n    }\n\n    VendorInvoice {\n        int Id PK\n        int PurchaseOrderId FK\n        string InvoiceNumber\n        datetime InvoiceDate\n        decimal TotalAmount\n        string Status\n    }\n\n    Customer {\n        int Id PK\n        string Name\n        string Phone\n    }\n\n    SalesOrder {\n        int Id PK\n        int CustomerId FK\n        int BranchId FK\n        string UserId FK\n        datetime OrderDate\n        string Status\n    }\n\n    SalesOrderItem {\n        int Id PK\n        int SalesOrderId FK\n        int ProductId FK\n        int Quantity\n        decimal UnitPrice\n    }\n\n    SalesInvoice {\n        int Id PK\n        int SalesOrderId FK\n        string InvoiceNumber\n        datetime InvoiceDate\n        decimal TotalAmount\n    }\n\n    InvoiceItem {\n        int Id PK\n        int SalesInvoiceId FK\n        int ProductId FK\n        int Quantity\n        decimal UnitPrice\n    }\n\n    CreditNote {\n        int Id PK\n        int SalesInvoiceId FK\n        datetime ReturnDate\n        string Reason\n        decimal RefundAmount\n    }\n\n    CreditNoteItem {\n        int Id PK\n        int CreditNoteId FK\n        int ProductId FK\n        int Quantity\n        decimal UnitPrice\n    }\n\n    %% العلاقات الأساسية (مطابقة للـ FKs الموجودة فعليًا في schema.sql)\n    Branch ||--o{ Warehouse : \&quot;has warehouses\&quot;\n    Warehouse ||--o{ BranchInventory : \&quot;stores inventory\&quot;\n    Branch ||--o{ ApplicationUser : \&quot;has employees\&quot;\n    Product ||--o{ BranchInventory : \&quot;tracked in\&quot;\n    Category ||--o{ Product : \&quot;categorizes\&quot;\n\n    Vendor ||--o{ PurchaseOrder : \&quot;receives PO\&quot;\n    Branch ||--o{ PurchaseOrder : \&quot;requested by branch\&quot;\n    PurchaseOrder ||--o{ PurchaseOrderItem : \&quot;includes items\&quot;\n    Product ||--o{ PurchaseOrderItem : \&quot;ordered as\&quot;\n    PurchaseOrder ||--o{ VendorInvoice : \&quot;billed by\&quot;\n\n    Customer ||--o{ SalesOrder : \&quot;places SO\&quot;\n    Branch ||--o{ SalesOrder : \&quot;sold from branch\&quot;\n    ApplicationUser ||--o{ SalesOrder : \&quot;processed by\&quot;\n    SalesOrder ||--o{ SalesOrderItem : \&quot;contains items\&quot;\n    Product ||--o{ SalesOrderItem : \&quot;sold as\&quot;\n    SalesOrder ||--o{ SalesInvoice : \&quot;generates invoice\&quot;\n\n    SalesInvoice ||--o{ InvoiceItem : \&quot;contains items\&quot;\n    Product ||--o{ InvoiceItem : \&quot;billed as\&quot;\n\n    SalesInvoice ||--o{ CreditNote : \&quot;has returns\&quot;\n    CreditNote ||--o{ CreditNoteItem : \&quot;includes returned items\&quot;\n    Product ||--o{ CreditNoteItem : \&quot;returned as\&quot;\n\n    ApplicationUser ||--o{ UserRole : \&quot;assigned\&quot;\n    Role ||--o{ UserRole : \&quot;includes\&quot;\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="376">
