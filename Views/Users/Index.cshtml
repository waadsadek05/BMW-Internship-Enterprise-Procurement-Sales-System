@model IEnumerable<EnterpriseSystem.Models.ApplicationUser>

@{
    ViewData["Title"] = "Manage Users";
}

<!-- عنوان الصفحة -->
<div class="mb-3">
    <h2>Manage Users</h2>
</div>

<!-- زرار Create فقط في سطر مستقل -->
<div class="mb-4">
    <a asp-action="Create" class="btn btn-success text-nowrap px-3">Create New User</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Full Name</th>
                <th>Username</th>
                <th>Email</th>
                <th>Branch</th>
                <th>Roles</th> 
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                var userRolesDict = ViewBag.UserRoles as Dictionary<string, List<string>>;

                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.FullName</td>
                        <td>@item.Username</td>
                        <td>@item.Email</td>
                        <td>
                            @if (item.Branch != null)
                            {
                                <span class="fw-bold text-dark">@item.Branch.Name</span>
                            }
                            else
                            {
                                <span class="text-muted">No Branch</span>
                            }
                        </td>
                        <td>
                            @if (userRolesDict != null && userRolesDict.ContainsKey(item.Id) && userRolesDict[item.Id].Any())
                            {
                                <span class="badge bg-info text-dark text-wrap text-start" style="max-width: 250px;">
                                    @string.Join(", ", userRolesDict[item.Id])
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">No Roles</span>
                            }
                        </td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-1">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Edit</a>

                                <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" class="d-inline m-0">
                                    @if (item.IsActive)
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Deactivate</button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-success">Activate</button>
                                    }
                                </form>

                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline m-0" onsubmit="return confirm('Are you sure you want to delete this user?');">
                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">No users found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- أزرار التنقل بين الصفحات (Pagination) -->
<div class="mt-4 d-flex justify-content-between align-items-center">
    <div class="text-muted small">
        Page @ViewBag.CurrentPage of @(ViewBag.TotalPages > 0 ? ViewBag.TotalPages : 1)
    </div>
    <div>
        @if (ViewBag.CurrentPage > 1)
        {
            <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)" class="btn btn-outline-dark btn-sm">Previous</a>
        }
        
        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
        {
            <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" class="btn btn-outline-dark btn-sm ms-1">Next</a>
        }
    </div>
</div>