@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid mt-4">
    <div class="jumbotron bg-light p-5 rounded shadow-sm mb-4 border text-center">
        <h1 class="display-4 text-primary fw-bold">Enterprise System Management</h1>
        <p class="lead text-muted">Welcome back, System Admin. Manage your enterprise modules efficiently from the navigation bar.</p>
        <hr class="my-4">
        <a asp-action="Approvals" class="btn btn-primary btn-lg fw-bold text-white shadow-sm">
            <i class="fas fa-bell me-2"></i> View Pending Approvals & Requests
        </a>
    </div>

    <!-- البطاقات الأربع الأساسية للأقسام -->
    <div class="row text-center">
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm border-0 h-100 bg-white">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div><div class="text-primary mb-3"><i class="fas fa-shopping-cart fa-2x"></i></div><h5>Procurement</h5></div>
                    <a asp-controller="PurchaseOrders" asp-action="Index" class="btn btn-outline-primary btn-sm mt-3">Go to Procurement</a>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm border-0 h-100 bg-white">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div><div class="text-success mb-3"><i class="fas fa-warehouse fa-2x"></i></div><h5>Inventory</h5></div>
                    <a asp-controller="BranchInventory" asp-action="Index" class="btn btn-outline-success btn-sm mt-3">Go to Inventory</a>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm border-0 h-100 bg-white">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div><div class="text-warning mb-3"><i class="fas fa-file-invoice-dollar fa-2x"></i></div><h5>Sales Operations</h5></div>
                    <a asp-controller="SalesInvoices" asp-action="Index" class="btn btn-outline-warning btn-sm mt-3">Go to Sales</a>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm border-0 h-100 bg-white">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div><div class="text-danger mb-3"><i class="fas fa-undo fa-2x"></i></div><h5>Returns</h5></div>
                    <a asp-controller="CreditNotes" asp-action="Index" class="btn btn-outline-danger btn-sm mt-3">Go to Returns</a>
                </div>
            </div>
        </div>
    </div>
</div>