@{
    ViewData["Title"] = "System Policy & Privacy";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white">
            <h3 class="mb-0">Enterprise System - Security & Usage Policy</h3>
        </div>
        <div class="card-body p-4">
            <h5 class="text-primary fw-bold">1. Data Confidentiality</h5>
            <p class="text-muted">All data processed within this Enterprise System—including sales records, inventory levels, procurement details, and financial figures—is strictly confidential and intended solely for authorized internal business operations.</p>
            <hr />

            <h5 class="text-primary fw-bold">2. User Accountability</h5>
            <p class="text-muted">System actions performed under your credentials (such as System Admin or staff roles) are logged. Users are responsible for maintaining the security of their login credentials and ensuring all inventory and financial entries are accurate.</p>
            <hr />

            <h5 class="text-primary fw-bold">3. Compliance & Auditing</h5>
            <p class="text-muted">Transactions like Credit Notes, stock adjustments, and invoice generation are monitored to maintain financial integrity and accurate audit trails across all branch warehouses.</p>
            <hr />

            <p class="small text-secondary mb-0">For technical support or security concerns, please contact the IT System Administration team.</p>
        </div>
    </div>
</div>