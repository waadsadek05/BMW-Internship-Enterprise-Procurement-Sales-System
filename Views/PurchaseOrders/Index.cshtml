@model IEnumerable<EnterpriseSystem.Models.PurchaseOrder>
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Purchase Orders";

    string currentUsername = HttpContextAccessor.HttpContext?.Session.GetString("Username") ?? "";

    bool isSystemAdmin = currentUsername.Equals("admin", StringComparison.OrdinalIgnoreCase) || 
                         User.IsInRole("Admin");

    bool canManage = isSystemAdmin || 
                     currentUsername.Equals("po_create", StringComparison.OrdinalIgnoreCase) || 
                     User.IsInRole("PO_Creator") || 
                     User.IsInRole("po_create") || 
                     User.IsInRole("PO Creator");
}

<div class="container mt-4">
    <h1>Purchase Orders</h1>

    @if (canManage)
    {
        <p>
            <a asp-action="Create" class="btn btn-success">Create New Purchase Order</a>
        </p>
    }

    <table class="table table-bordered table-striped align-middle">
        <thead class="bg-primary text-white">
            <tr>
                <th>@Html.DisplayNameFor(model => model.OrderDate)</th>
                <th>@Html.DisplayNameFor(model => model.Status)</th>
                <th>@Html.DisplayNameFor(model => model.Branch)</th>
                <th>@Html.DisplayNameFor(model => model.Vendor)</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model) {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.OrderDate)</td>
                        <td>@Html.DisplayFor(modelItem => item.Status)</td>
                        <td>@Html.DisplayFor(modelItem => item.Branch.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.Vendor.Name)</td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-warning text-dark fw-bold">Details</a>

                            @if (canManage)
                            {
                                <text> | </text>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Edit</a>
                                <text> | </text>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">No purchase orders found.</td>
                </tr>
            }
        </tbody>
    </table>
    <!-- أزرار التنقل بين الصفحات (Pagination) -->
    <!-- أزرار التنقل على اليمين تحت الجدول -->
    <div class="mt-4 d-flex justify-content-end align-items-center">
        <div>
            @if (ViewBag.CurrentPage > 1)
            {
                <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)" class="btn btn-dark btn-sm">Previous</a>
            }
            
            <span class="mx-3 fw-bold">Page @ViewBag.CurrentPage of @ViewBag.TotalPages</span>

            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" class="btn btn-dark btn-sm">Next</a>
            }
        </div>
    </div>
</div>