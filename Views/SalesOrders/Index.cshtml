@model IEnumerable<EnterpriseSystem.Models.SalesOrder>
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Sales Orders";

    // جلب اسم المستخدم الحالي من الـ Session والتحقق من الصلاحيات بمرونة تامة
    string currentUsername = HttpContextAccessor.HttpContext?.Session.GetString("Username") ?? "";
    
    bool isSystemAdmin = currentUsername.Equals("admin", StringComparison.OrdinalIgnoreCase) || User.IsInRole("Admin");

    bool canManage = isSystemAdmin || 
                     currentUsername.Contains("sales_create", StringComparison.OrdinalIgnoreCase) || 
                     currentUsername.Contains("Creator", StringComparison.OrdinalIgnoreCase) || 
                     User.IsInRole("Sales_Creator") || 
                     User.IsInRole("sales_create") || 
                     User.IsInRole("Sales Creator");
}

<div class="container mt-4">
    <h1>Sales Orders</h1>

    <!-- زر Create New يظهر للأدمن أو المنشئ فقط (نفس كودك القديم تماماً) -->
    @if (canManage)
    {
        <p>
            <a asp-action="Create" class="btn btn-success">Create New Sales Order</a>
        </p>
    }

    <table class="table table-bordered table-striped align-middle">
        <thead class="bg-primary text-white">
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Id)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.OrderDate)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Status)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Branch)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Customer)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.User)
                </th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model) {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Id)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.OrderDate)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Status)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Branch.Name)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Customer.Name)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.User.FullName)
                        </td>
                        <td class="text-center">
                            <!-- زر Details (الأصفر) يظهر للجميع -->
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-warning text-dark fw-bold">Details</a>

                            <!-- أزرار Edit و Delete تظهر للأدمن أو من يملك صلاحية الإدارة فقط -->
                            @if (canManage)
                            {
                                <text> | </text>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Edit</a>
                                <text> | </text>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted">No sales orders found.</td>
                </tr>
            }
        </tbody>
    </table>

    <!-- أزرار التنقل بين الصفحات (Pagination) -->
    <div class="mt-4 d-flex justify-content-end align-items-center">
        <div>
            @if (ViewBag.CurrentPage > 1)
            {
                <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)" class="btn btn-dark btn-sm">Previous</a>
            }
            
            <span class="mx-3 fw-bold">Page @ViewBag.CurrentPage of @(ViewBag.TotalPages > 0 ? ViewBag.TotalPages : 1)</span>

            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" class="btn btn-dark btn-sm">Next</a>
            }
        </div>
    </div>
</div>