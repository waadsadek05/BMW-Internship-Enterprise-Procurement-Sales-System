@{
    ViewData["Title"] = "Create Role";
}

<div class="container mt-4">
    <h2>Create New Role</h2>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form asp-controller="Roles" asp-action="Create" method="post">
                
                <!-- عرض رسالة الخطأ العامة إن وجدت -->
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label class="control-label fw-bold">Role Name</label>
                    <!-- استخدام name="name" و value عادي جداً بدون Tag Helpers معقدة لتجنب مشاكل الـ Dynamic -->
                    <input type="text" name="name" class="form-control" placeholder="Enter Role Name" required />
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-success">Create</button>
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>