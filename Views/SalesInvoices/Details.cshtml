@model EnterpriseSystem.Models.SalesInvoice

@{
    ViewData["Title"] = "Sales Invoices";
}

<style>
    /* منع ظهور أي عناصر بحث غير مرغوب فيها داخل الصفحة */
    input[placeholder*="Search"], input[type="search"] {
        display: none !important;
    }
</style>

<h1>Sales Invoices</h1>

<div>
    <h4>Invoice #@Model.InvoiceNumber</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.InvoiceNumber)
        </dt>
        <dd class="col-sm-10">
            @Model.InvoiceNumber
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.InvoiceDate)
        </dt>
        <dd class="col-sm-10">
            @Model.InvoiceDate
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.TotalAmount)
        </dt>
        <dd class="col-sm-10">
            @Model.TotalAmount.ToString("C")
        </dd>
        <dt class="col-sm-2">
            Sales Order ID
        </dt>
        <dd class="col-sm-10">
            <a asp-controller="SalesOrders" asp-action="Details" asp-route-id="@Model.SalesOrderId">
                #@Model.SalesOrderId
            </a>
        </dd>
        <dt class="col-sm-2">
            Customer
        </dt>
        <dd class="col-sm-10">
            @Model.SalesOrder?.Customer?.Name
        </dd>
        <dt class="col-sm-2">
            Branch
        </dt>
        <dd class="col-sm-10">
            @Model.SalesOrder?.Branch?.Name
        </dd>
    </dl>
</div>

<hr />
<div class="mb-3">
    <h4>Invoice Items</h4>
</div>

@if (Model.SalesOrder?.SalesOrderItems != null && Model.SalesOrder.SalesOrderItems.Count > 0)
{
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Product Name</th>
                <th>Unit Price</th>
                <th>Quantity</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.SalesOrder.SalesOrderItems)
            {
                <tr>
                    <td>@item.Product?.Name</td>
                    <td>@item.UnitPrice.ToString("C")</td>
                    <td>@item.Quantity</td>
                    <td>@((item.Quantity * item.UnitPrice).ToString("C"))</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">No items found for this invoice.</p>
}

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>