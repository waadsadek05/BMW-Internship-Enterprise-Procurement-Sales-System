@model IEnumerable<EnterpriseSystem.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<div class="container mt-4">
    <h1>Products</h1>

    <!-- حاوية تضم زرار الـ Create وشريط البحث -->
    <div class="d-flex justify-content-between align-items-center mb-3" id="actionsContainer">
        <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#createProductModal">
            Create New Product
        </button>
    </div>

    <table class="table table-bordered table-striped align-middle" id="productsTable">
        <thead class="bg-primary text-white">
            <tr>
                <th>@Html.DisplayNameFor(model => model.Name)</th>
                <th>@Html.DisplayNameFor(model => model.Sku)</th>
                <th>@Html.DisplayNameFor(model => model.UnitPrice)</th>
                <th>@Html.DisplayNameFor(model => model.Category)</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model) {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.Sku)</td>
                        <td>@Html.DisplayFor(modelItem => item.UnitPrice)</td>
                        <td>@Html.DisplayFor(modelItem => item.Category.Name)</td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Edit</a> |
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-warning text-dark fw-bold">Details</a> |
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">No products found.</td>
                </tr>
            }
        </tbody>
    </table>

    <!-- أزرار التنقل على اليمين (Pagination) -->
    <div class="mt-4 d-flex justify-content-end align-items-center">
        <div>
            @if (ViewBag.CurrentPage > 1)
            {
                <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)" asp-route-searchString="@ViewBag.CurrentFilter" class="btn btn-dark btn-sm">Previous</a>
            }
            
            <span class="mx-3 fw-bold">Page @ViewBag.CurrentPage of @(ViewBag.TotalPages > 0 ? ViewBag.TotalPages : 1)</span>

            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" asp-route-searchString="@ViewBag.CurrentFilter" class="btn btn-dark btn-sm">Next</a>
            }
        </div>
    </div>
</div>

<!-- Modal النافذة المنبثقة لإضافة منتج جديد -->
<div class="modal fade" id="createProductModal" tabindex="-1" aria-labelledby="createProductModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form asp-action="Create" method="post">
          <div class="modal-header">
            <h5 class="modal-title" id="createProductModalLabel">Create New Product</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
              <div class="mb-3">
                  <label class="control-label">Name</label>
                  <input name="Name" class="form-control" required />
              </div>
              <div class="mb-3">
                  <label class="control-label">Sku</label>
                  <input name="Sku" class="form-control" required />
              </div>
              <div class="mb-3">
                  <label class="control-label">Unit Price</label>
                  <input name="UnitPrice" type="number" step="0.01" class="form-control" required />
              </div>
              <div class="mb-3">
                  <label class="control-label">Category</label>
                  <select name="CategoryId" class="form-control" asp-items="ViewBag.CategoryId" id="categorySelect">
                      <option value="">-- Select Category --</option>
                  </select>
              </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary">Save Product</button>
          </div>
      </form>
    </div>
  </div>
</div>

@section Scripts {
    <!-- إضافة ملفات مكتبة Select2 للبحث داخل القائمة المنسدلة -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function() {
            // تفعيل البحث والتكملة التلقائية داخل الـ Dropdown للـ Category جوه الـ Modal
            $('#categorySelect').select2({
                dropdownParent: $('#createProductModal'),
                width: '100%',
                placeholder: "-- Select Category --",
                allowClear: true
            });

            // نقل شريط البحث القديم ليصبح بجانب زرار الـ Create أوتوماتيكياً
            var oldSearchInput = $("input[placeholder*='Search in this page']");
            if(oldSearchInput.length) {
                var searchWrapper = oldSearchInput.closest('div');
                searchWrapper.css({ 'margin-bottom': '0', 'max-width': '350px' });
                $('#actionsContainer').append(searchWrapper);
            }
        });
    </script>
}